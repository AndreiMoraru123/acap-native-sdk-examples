{
    "schemaVersion": "1.8.0",
    "resources": {
        "dbus": {
            "requiredMethods": ["com.axis.Graphics2.*", "com.axis.Overlay2.*"]
        },
        "linux": {
            "user": {
                "groups": ["video"]
            }
        }
    },
    "acapPackageConf": {
        "setup": {
            "friendlyName": "license_plate_ocr_yolov8_artpec8",
            "appName": "license_plate_ocr_yolov8",
            "vendor": "Axis Communications",
            "embeddedSdkVersion": "3.0",
            "runOptions": "/usr/local/packages/license_plate_ocr_yolov8/model/model.tflite /usr/local/packages/license_plate_ocr_yolov8/label/labels.txt  -c axis-a8-dlpu-tflite",
            "vendorUrl": "https://www.axis.com",
            "runMode": "never",
            "version": "1.0.0"
        },
        "configuration": {}
    }
}
